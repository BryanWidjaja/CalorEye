{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CalorEye model bundle manifest",
  "type": "object",
  "required": ["schema_version", "bundle_id", "joint_model_version", "minimum_app_version", "minimum_decoder_version", "created_at_utc", "code_revision", "dataset_manifest_sha256", "split_sha256", "assets", "environment", "pixels", "stage_one", "stage_two", "classes", "thresholds"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "joint_model_version": {"type": "string", "minLength": 1},
    "minimum_app_version": {"type": "string", "minLength": 1},
    "minimum_decoder_version": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "minLength": 1},
    "code_revision": {"type": "string", "minLength": 40},
    "dataset_manifest_sha256": {"type": ["string", "null"]},
    "split_sha256": {"type": ["string", "null"]},
    "assets": {
      "type": "object",
      "required": ["stage_one", "stage_two"],
      "additionalProperties": false,
      "properties": {
        "stage_one": {"$ref": "#/$defs/asset"},
        "stage_two": {"$ref": "#/$defs/asset"}
      }
    },
    "environment": {
      "type": "object",
      "required": ["python", "torch", "timm", "ultralytics", "executorch", "precision", "stage_one_exporter", "stage_two_delegate", "target_abis"],
      "properties": {
        "python": {"type": "string"},
        "torch": {"type": "string"},
        "timm": {"type": "string"},
        "ultralytics": {"type": "string"},
        "executorch": {"type": "string"},
        "precision": {"const": "float32"},
        "stage_one_exporter": {"type": "string"},
        "stage_two_delegate": {"type": "string"},
        "target_abis": {"type": "array", "items": {"type": "string"}}
      }
    },
    "pixels": {
      "type": "object",
      "required": ["exif_orientation", "color", "alpha", "grayscale", "metadata"],
      "properties": {
        "exif_orientation": {"const": "apply once before geometry, orientations 1-8"},
        "color": {"const": "RGB uint8"},
        "alpha": {"const": "convert to RGB"},
        "grayscale": {"const": "convert to RGB"},
        "metadata": {"const": "discard after decoding"}
      }
    },
    "stage_one": {
      "type": "object",
      "required": ["input_shape", "input_layout", "input_dtype", "channel_order", "scale", "letterbox", "raw_outputs", "decode"],
      "properties": {
        "input_shape": {"const": [1, 3, 640, 640]},
        "input_layout": {"const": "NCHW"},
        "input_dtype": {"const": "float32 contiguous"},
        "channel_order": {"const": "RGB"},
        "scale": {"const": "uint8 / 255"},
        "letterbox": {"type": "object"},
        "raw_outputs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/output"}},
        "decode": {"type": "object"}
      }
    },
    "stage_two": {
      "type": "object",
      "required": ["input_shape", "input_dtype", "crop_rule", "padding", "resize", "mean", "std", "output_shape", "score_path"],
      "properties": {
        "input_shape": {"const": [1, 3, 224, 224]},
        "input_dtype": {"const": "float32 contiguous"},
        "crop_rule": {"type": "string"},
        "padding": {"type": "string"},
        "resize": {"type": "string"},
        "mean": {"const": [0.5, 0.5, 0.5]},
        "std": {"const": [0.5, 0.5, 0.5]},
        "output_shape": {"const": [1, 7]},
        "score_path": {"const": "linear head logits then temperature softmax"}
      }
    },
    "classes": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/class"}},
    "thresholds": {
      "type": "object",
      "required": ["temperature", "dish_acceptance", "not_food"],
      "properties": {
        "temperature": {"type": ["number", "null"]},
        "dish_acceptance": {"type": ["number", "null"]},
        "not_food": {"type": ["number", "null"]}
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["filename", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 64},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "output": {
      "type": "object",
      "required": ["index", "shape", "dtype", "axes"],
      "properties": {
        "index": {"type": "integer"},
        "shape": {"type": "array", "items": {"type": "integer"}},
        "dtype": {"const": "float32"},
        "axes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "class": {
      "type": "object",
      "required": ["index", "source_id", "name_id"],
      "properties": {
        "index": {"type": "integer"},
        "source_id": {"type": "string"},
        "name_id": {"type": "string"}
      }
    }
  }
}
